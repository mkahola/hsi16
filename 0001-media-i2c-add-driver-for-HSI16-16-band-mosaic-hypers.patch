From feaf08a0fcbd793a53e02f6be3a64c2170b7ba86 Mon Sep 17 00:00:00 2001
From: Mika Kahola <mika.kahola@kolumbus.fi>
Date: Fri, 18 Sep 2026 09:58:32 +0000
Subject: [PATCH 1/3] media: i2c: add driver for HSI16 16-band mosaic
 hyperspectral sensor

Add a v4l2-subdev driver for the HSI16 sensor: a miniature CMOS image
sensor with an on-die Fabry-Perot spectral filter array (4x4 = 16-band
mosaic), controlled over I2C with pixel data on 2-lane MIPI CSI-2.

There is no standard V4L2 media-bus code for an N-band spectral mosaic,
so the driver advertises MEDIA_BUS_FMT_SRGGB10_1X10 as a raw transport
container and interoperates with a stock CSI-2 receiver unmodified. The
spectral mapping (mosaic period, per-band CWL/FWHM, calibration LUT) is
intended to travel out-of-band via a companion metadata node keyed to
the same frame sequence number.

CONFIG_HSI16_FAKE_HW replaces the I2C register backend with an in-memory
model, so probe, format negotiation, control handling, the streaming
state machine and PM transitions can all be exercised with
v4l2-compliance and no sensor attached. It does not emulate CSI-2 pixel
data.

Signed-off-by: Mika Kahola <mika.kahola@kolumbus.fi>
---
 drivers/media/i2c/hsi16.c | 723 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 723 insertions(+)
 create mode 100644 drivers/media/i2c/hsi16.c

diff --git a/drivers/media/i2c/hsi16.c b/drivers/media/i2c/hsi16.c
new file mode 100644
index 000000000000..8d95beb53689
--- /dev/null
+++ b/drivers/media/i2c/hsi16.c
@@ -0,0 +1,723 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Driver for the HSI16 miniature hyperspectral (16-band Fabry-Perot
+ * mosaic) CMOS image sensor.
+ *
+ * Copyright (C) 2026 Example Corp.
+ *
+ * Pixel data is emitted as a standard SRGGB10 raw container over
+ * MIPI CSI-2; the true spectral-mosaic interpretation (band count,
+ * per-band CWL/FWHM, calibration LUT) is carried out-of-band via a
+ * companion metadata node and is not part of this file.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/media-entity.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define HSI16_REG_CHIP_ID		0x0000
+#define HSI16_CHIP_ID			0x4831
+#define HSI16_REG_STREAM		0x0100
+#define HSI16_REG_EXPOSURE		0x0202
+#define HSI16_REG_ANALOG_GAIN		0x0204
+#define HSI16_REG_FP_BIAS		0x3a00	/* MEMS FP cavity bias DAC */
+#define HSI16_REG_TEMP_SENSOR		0x3b00	/* on-die temp, read-only */
+
+#define HSI16_NATIVE_WIDTH		2048
+#define HSI16_NATIVE_HEIGHT		1536
+#define HSI16_MOSAIC_PERIOD		4	/* 4x4 = 16 bands */
+
+/* Vendor control: MEMS Fabry-Perot cavity bias DAC, 12-bit */
+#define V4L2_CID_USER_HSI16_FP_BIAS	(V4L2_CID_USER_BASE + 0x1001)
+
+struct hsi16_reg {
+	u16 addr;
+	u8 val;
+};
+
+static const struct hsi16_reg mode_2048x1536_regs[] = {
+	{ 0x0300, 0x01 },
+	{ 0x0301, 0x00 },
+	/* ... sensor-specific mode/timing/PLL programming ... */
+};
+
+static const struct hsi16_reg mode_1024x768_regs[] = {
+	{ 0x0300, 0x02 },
+	{ 0x0301, 0x00 },
+	/* ... */
+};
+
+struct hsi16_mode {
+	u32 width;
+	u32 height;
+	u32 mosaic_period;
+	const struct hsi16_reg *reglist;
+	unsigned int reglist_len;
+};
+
+static const struct hsi16_mode hsi16_modes[] = {
+	{
+		.width = HSI16_NATIVE_WIDTH,
+		.height = HSI16_NATIVE_HEIGHT,
+		.mosaic_period = HSI16_MOSAIC_PERIOD,
+		.reglist = mode_2048x1536_regs,
+		.reglist_len = ARRAY_SIZE(mode_2048x1536_regs),
+	},
+	{
+		.width = 1024,
+		.height = 768,
+		.mosaic_period = HSI16_MOSAIC_PERIOD,
+		.reglist = mode_1024x768_regs,
+		.reglist_len = ARRAY_SIZE(mode_1024x768_regs),
+	},
+};
+
+/*
+ * Only the standard SRGGB10 compat container is advertised.
+ * A vendor-defined mosaic mbus code intentionally is NOT added here
+ * so this driver stays usable with an unmodified CSI-2 receiver;
+ * see cover letter / commit message.
+ */
+static const u32 hsi16_mbus_codes[] = {
+	MEDIA_BUS_FMT_SRGGB10_1X10,
+};
+
+struct hsi16_dev {
+	struct device *dev;
+	struct i2c_client *client;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct clk *xclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator *vdd;
+
+	struct mutex lock; /* protects cur_mode, streaming */
+	const struct hsi16_mode *cur_mode;
+	unsigned int active_mosaic_period;
+	bool streaming;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *again;
+	struct v4l2_ctrl *fp_bias; /* MEMS FP cavity bias, vendor ctrl */
+};
+
+#ifdef CONFIG_HSI16_FAKE_HW
+
+/*
+ * Fake register model, used instead of real I2C when
+ * CONFIG_HSI16_FAKE_HW=y. Lets the whole driver -- probe, chip-id
+ * check, media-controller setup, format negotiation, control
+ * handling, streaming state machine, PM transitions -- be exercised
+ * with v4l2-compliance/media-ctl/v4l2-ctl and no sensor attached.
+ *
+ * Does NOT emulate CSI-2 pixel data; this only fakes the register
+ * plane. Pixel-data-plane testing is a separate harness.
+ */
+#define HSI16_FAKE_REG_SPACE	0x4000
+
+struct hsi16_fake_hw {
+	u8 regs[HSI16_FAKE_REG_SPACE];
+};
+
+static struct hsi16_fake_hw hsi16_fake_hw_state = {
+	.regs = {
+		[HSI16_REG_CHIP_ID]     = HSI16_CHIP_ID >> 8,
+		[HSI16_REG_CHIP_ID + 1] = HSI16_CHIP_ID & 0xff,
+		[HSI16_REG_TEMP_SENSOR] = 0x1e, /* ~30 C, arbitrary */
+	},
+};
+
+static DEFINE_MUTEX(hsi16_fake_hw_lock);
+
+static int hsi16_fake_write_reg(struct hsi16_dev *sensor, u16 reg, u8 val)
+{
+	if (reg >= HSI16_FAKE_REG_SPACE)
+		return -EINVAL;
+
+	mutex_lock(&hsi16_fake_hw_lock);
+	hsi16_fake_hw_state.regs[reg] = val;
+	mutex_unlock(&hsi16_fake_hw_lock);
+
+	dev_dbg(sensor->dev, "fake_hw: wr 0x%04x = 0x%02x\n", reg, val);
+	return 0;
+}
+
+static int hsi16_fake_read_reg(struct hsi16_dev *sensor, u16 reg, u8 *val)
+{
+	if (reg >= HSI16_FAKE_REG_SPACE)
+		return -EINVAL;
+
+	mutex_lock(&hsi16_fake_hw_lock);
+	*val = hsi16_fake_hw_state.regs[reg];
+	mutex_unlock(&hsi16_fake_hw_lock);
+
+	dev_dbg(sensor->dev, "fake_hw: rd 0x%04x -> 0x%02x\n", reg, *val);
+	return 0;
+}
+
+#endif /* CONFIG_HSI16_FAKE_HW */
+
+static inline struct hsi16_dev *to_hsi16_dev(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct hsi16_dev, sd);
+}
+
+/* -------------------------------------------------------------------- */
+/* Register access                                                      */
+
+static int hsi16_write_reg(struct hsi16_dev *sensor, u16 reg, u8 val)
+{
+#ifdef CONFIG_HSI16_FAKE_HW
+	return hsi16_fake_write_reg(sensor, reg, val);
+#else
+	u8 buf[3];
+	struct i2c_msg msg;
+
+	buf[0] = reg >> 8;
+	buf[1] = reg & 0xff;
+	buf[2] = val;
+
+	msg.addr = sensor->client->addr;
+	msg.flags = 0;
+	msg.buf = buf;
+	msg.len = sizeof(buf);
+
+	return i2c_transfer(sensor->client->adapter, &msg, 1) == 1 ? 0 : -EIO;
+#endif
+}
+
+static int hsi16_read_reg(struct hsi16_dev *sensor, u16 reg, u8 *val)
+{
+#ifdef CONFIG_HSI16_FAKE_HW
+	return hsi16_fake_read_reg(sensor, reg, val);
+#else
+	u8 addr_buf[2] = { reg >> 8, reg & 0xff };
+	struct i2c_msg msgs[2] = {
+		{
+			.addr = sensor->client->addr,
+			.flags = 0,
+			.buf = addr_buf,
+			.len = sizeof(addr_buf),
+		},
+		{
+			.addr = sensor->client->addr,
+			.flags = I2C_M_RD,
+			.buf = val,
+			.len = 1,
+		},
+	};
+
+	return i2c_transfer(sensor->client->adapter, msgs, 2) == 2 ? 0 : -EIO;
+#endif
+}
+
+static int hsi16_load_reglist(struct hsi16_dev *sensor,
+			       const struct hsi16_mode *mode)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < mode->reglist_len; i++) {
+		ret = hsi16_write_reg(sensor, mode->reglist[i].addr,
+				       mode->reglist[i].val);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/* -------------------------------------------------------------------- */
+/* v4l2_ctrl_ops                                                        */
+
+static int hsi16_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct hsi16_dev *sensor =
+		container_of(ctrl->handler, struct hsi16_dev, ctrl_handler);
+	int ret = 0;
+
+	/* Runtime-suspended: cache handled by ctrl framework, apply on resume */
+	if (!pm_runtime_get_if_in_use(sensor->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = hsi16_write_reg(sensor, HSI16_REG_EXPOSURE, ctrl->val);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = hsi16_write_reg(sensor, HSI16_REG_ANALOG_GAIN, ctrl->val);
+		break;
+	default:
+		/* HSI16_CID_FP_BIAS and other vendor ctrls handled here too */
+		if (ctrl->id == V4L2_CID_USER_HSI16_FP_BIAS)
+			ret = hsi16_write_reg(sensor, HSI16_REG_FP_BIAS, ctrl->val);
+		else
+			ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(sensor->dev);
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops hsi16_ctrl_ops = {
+	.s_ctrl = hsi16_s_ctrl,
+};
+
+/* Vendor control: MEMS Fabry-Perot cavity bias DAC, 12-bit */
+static const struct v4l2_ctrl_config hsi16_ctrl_fp_bias = {
+	.ops = &hsi16_ctrl_ops,
+	.id = V4L2_CID_USER_HSI16_FP_BIAS,
+	.name = "FP Cavity Bias",
+	.type = V4L2_CTRL_TYPE_INTEGER,
+	.min = 0,
+	.max = 4095,
+	.step = 1,
+	.def = 2048,
+};
+
+static int hsi16_init_controls(struct hsi16_dev *sensor)
+{
+	struct v4l2_ctrl_handler *hdl = &sensor->ctrl_handler;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 3);
+	if (ret)
+		return ret;
+
+	sensor->exposure = v4l2_ctrl_new_std(hdl, &hsi16_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     4, 65535, 1, 1024);
+	sensor->again = v4l2_ctrl_new_std(hdl, &hsi16_ctrl_ops,
+					   V4L2_CID_ANALOGUE_GAIN,
+					   0, 480, 1, 0);
+	sensor->fp_bias = v4l2_ctrl_new_custom(hdl, &hsi16_ctrl_fp_bias, NULL);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+
+	sensor->sd.ctrl_handler = hdl;
+	return 0;
+}
+
+/* -------------------------------------------------------------------- */
+/* v4l2_subdev_pad_ops                                                  */
+
+static bool hsi16_code_supported(u32 code)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(hsi16_mbus_codes); i++)
+		if (hsi16_mbus_codes[i] == code)
+			return true;
+	return false;
+}
+
+static const struct hsi16_mode *hsi16_find_mode(u32 width, u32 height)
+{
+	const struct hsi16_mode *best = &hsi16_modes[0];
+	int best_err = INT_MAX;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(hsi16_modes); i++) {
+		int err = abs((int)hsi16_modes[i].width - (int)width) +
+			  abs((int)hsi16_modes[i].height - (int)height);
+		if (err < best_err) {
+			best_err = err;
+			best = &hsi16_modes[i];
+		}
+	}
+
+	return best;
+}
+
+static int hsi16_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index >= ARRAY_SIZE(hsi16_mbus_codes))
+		return -EINVAL;
+
+	code->code = hsi16_mbus_codes[code->index];
+	return 0;
+}
+
+static int hsi16_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(hsi16_modes))
+		return -EINVAL;
+	if (!hsi16_code_supported(fse->code))
+		return -EINVAL;
+
+	fse->min_width = fse->max_width = hsi16_modes[fse->index].width;
+	fse->min_height = fse->max_height = hsi16_modes[fse->index].height;
+	return 0;
+}
+
+static int hsi16_get_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *sd_state,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct v4l2_mbus_framefmt *mbus_fmt;
+
+	if (fmt->pad != 0)
+		return -EINVAL;
+
+	mbus_fmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
+	fmt->format = *mbus_fmt;
+	return 0;
+}
+
+static int hsi16_set_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *sd_state,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct hsi16_dev *sensor = to_hsi16_dev(sd);
+	const struct hsi16_mode *mode;
+	struct v4l2_mbus_framefmt *mbus_fmt;
+
+	if (fmt->pad != 0)
+		return -EINVAL;
+
+	if (!hsi16_code_supported(fmt->format.code))
+		fmt->format.code = hsi16_mbus_codes[0];
+
+	mode = hsi16_find_mode(fmt->format.width, fmt->format.height);
+
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_RAW;
+	fmt->format.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->format.quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->format.xfer_func = V4L2_XFER_FUNC_NONE;
+
+	mbus_fmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
+	*mbus_fmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		mutex_lock(&sensor->lock);
+		if (sensor->streaming) {
+			mutex_unlock(&sensor->lock);
+			return -EBUSY;
+		}
+		sensor->cur_mode = mode;
+		mutex_unlock(&sensor->lock);
+	}
+
+	return 0;
+}
+
+/*
+ * Seeds the TRY state so VIDIOC_SUBDEV_G_FMT on a fresh subdev fd
+ * returns something sane before any S_FMT. This lives in
+ * v4l2_subdev_internal_ops as .init_state; it used to be
+ * v4l2_subdev_pad_ops::init_cfg before that op was moved.
+ */
+static int hsi16_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *sd_state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = HSI16_NATIVE_WIDTH,
+			.height = HSI16_NATIVE_HEIGHT,
+			.code = hsi16_mbus_codes[0],
+		},
+	};
+
+	return hsi16_set_fmt(sd, sd_state, &fmt);
+}
+
+static const struct v4l2_subdev_internal_ops hsi16_internal_ops = {
+	.init_state = hsi16_init_state,
+};
+
+static const struct v4l2_subdev_pad_ops hsi16_pad_ops = {
+	.enum_mbus_code = hsi16_enum_mbus_code,
+	.enum_frame_size = hsi16_enum_frame_size,
+	.get_fmt = hsi16_get_fmt,
+	.set_fmt = hsi16_set_fmt,
+};
+
+/* -------------------------------------------------------------------- */
+/* v4l2_subdev_video_ops                                                */
+
+static int hsi16_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct hsi16_dev *sensor = to_hsi16_dev(sd);
+	int ret;
+
+	mutex_lock(&sensor->lock);
+
+	if (!enable) {
+		hsi16_write_reg(sensor, HSI16_REG_STREAM, 0);
+		sensor->streaming = false;
+		mutex_unlock(&sensor->lock);
+		pm_runtime_put(sensor->dev);
+		return 0;
+	}
+
+	ret = pm_runtime_get_sync(sensor->dev);
+	if (ret < 0)
+		goto err_unlock;
+
+	ret = hsi16_load_reglist(sensor, sensor->cur_mode);
+	if (ret)
+		goto err_pm;
+
+	ret = __v4l2_ctrl_handler_setup(&sensor->ctrl_handler);
+	if (ret)
+		goto err_pm;
+
+	sensor->active_mosaic_period = sensor->cur_mode->mosaic_period;
+
+	ret = hsi16_write_reg(sensor, HSI16_REG_STREAM, 1);
+	if (ret)
+		goto err_pm;
+
+	sensor->streaming = true;
+	mutex_unlock(&sensor->lock);
+	return 0;
+
+err_pm:
+	pm_runtime_put(sensor->dev);
+err_unlock:
+	mutex_unlock(&sensor->lock);
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops hsi16_video_ops = {
+	.s_stream = hsi16_s_stream,
+};
+
+static const struct v4l2_subdev_ops hsi16_subdev_ops = {
+	.video = &hsi16_video_ops,
+	.pad = &hsi16_pad_ops,
+};
+
+static const struct media_entity_operations hsi16_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+/* -------------------------------------------------------------------- */
+/* Power sequencing                                                     */
+
+static int hsi16_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct hsi16_dev *sensor = to_hsi16_dev(sd);
+	int ret;
+
+	ret = regulator_enable(sensor->vdd);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(sensor->xclk);
+	if (ret)
+		goto err_reg;
+
+	gpiod_set_value_cansleep(sensor->reset_gpio, 0);
+	usleep_range(2000, 2500); /* per datasheet power-up sequencing */
+
+	return 0;
+
+err_reg:
+	regulator_disable(sensor->vdd);
+	return ret;
+}
+
+static int hsi16_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct hsi16_dev *sensor = to_hsi16_dev(sd);
+
+	gpiod_set_value_cansleep(sensor->reset_gpio, 1);
+	clk_disable_unprepare(sensor->xclk);
+	regulator_disable(sensor->vdd);
+
+	return 0;
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(hsi16_pm_ops, hsi16_power_off,
+				  hsi16_power_on, NULL);
+
+/* -------------------------------------------------------------------- */
+/* Probe / remove                                                       */
+
+static int hsi16_identify(struct hsi16_dev *sensor)
+{
+	u8 hi, lo;
+	int ret;
+
+	ret = hsi16_read_reg(sensor, HSI16_REG_CHIP_ID, &hi);
+	if (ret)
+		return ret;
+	ret = hsi16_read_reg(sensor, HSI16_REG_CHIP_ID + 1, &lo);
+	if (ret)
+		return ret;
+
+	if (((hi << 8) | lo) != HSI16_CHIP_ID) {
+		dev_err(sensor->dev, "unexpected chip id 0x%02x%02x\n", hi, lo);
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+static int hsi16_probe(struct i2c_client *client)
+{
+	struct hsi16_dev *sensor;
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *endpoint;
+	int ret;
+
+	sensor = devm_kzalloc(&client->dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+
+	sensor->dev = &client->dev;
+	sensor->client = client;
+	mutex_init(&sensor->lock);
+	sensor->cur_mode = &hsi16_modes[0];
+
+	sensor->xclk = devm_clk_get(sensor->dev, "xclk");
+	if (IS_ERR(sensor->xclk))
+		return dev_err_probe(sensor->dev, PTR_ERR(sensor->xclk),
+				     "failed to get xclk\n");
+
+	sensor->vdd = devm_regulator_get(sensor->dev, "vdd");
+	if (IS_ERR(sensor->vdd))
+		return dev_err_probe(sensor->dev, PTR_ERR(sensor->vdd),
+				     "failed to get vdd regulator\n");
+
+	sensor->reset_gpio = devm_gpiod_get_optional(sensor->dev, "reset",
+						      GPIOD_OUT_HIGH);
+	if (IS_ERR(sensor->reset_gpio))
+		return dev_err_probe(sensor->dev, PTR_ERR(sensor->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(sensor->dev), NULL);
+	if (!endpoint)
+		return -ENXIO;
+
+	ret = v4l2_fwnode_endpoint_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(sensor->dev, ret,
+				     "failed to parse endpoint\n");
+
+	v4l2_i2c_subdev_init(&sensor->sd, client, &hsi16_subdev_ops);
+	sensor->sd.internal_ops = &hsi16_internal_ops;
+	sensor->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sensor->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sensor->sd.entity.ops = &hsi16_subdev_entity_ops;
+	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
+	if (ret)
+		goto err_free_ep;
+
+	ret = hsi16_init_controls(sensor);
+	if (ret)
+		goto err_free_entity;
+
+	/*
+	 * Allocates the subdev's active state and runs .init_state.
+	 * Must come after the control handler is attached and after
+	 * media_entity_pads_init(), and be undone with
+	 * v4l2_subdev_cleanup() on every exit path.
+	 */
+	ret = v4l2_subdev_init_finalize(&sensor->sd);
+	if (ret)
+		goto err_free_ctrls;
+
+	dev_set_drvdata(sensor->dev, &sensor->sd);
+
+	pm_runtime_enable(sensor->dev);
+	/*
+	 * resume_and_get() already drops its reference on failure, so
+	 * this path must not put again -- it only needs to undo
+	 * pm_runtime_enable() and everything before it.
+	 */
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret < 0)
+		goto err_pm_disable;
+
+	ret = hsi16_identify(sensor);
+	if (ret)
+		goto err_pm;
+
+	pm_runtime_put(sensor->dev);
+	pm_runtime_idle(sensor->dev);
+
+	ret = v4l2_async_register_subdev(&sensor->sd);
+	if (ret)
+		goto err_pm_disable;
+
+	return 0;
+
+err_pm:
+	pm_runtime_put(sensor->dev);
+err_pm_disable:
+	pm_runtime_disable(sensor->dev);
+	v4l2_subdev_cleanup(&sensor->sd);
+err_free_ctrls:
+	v4l2_ctrl_handler_free(&sensor->ctrl_handler);
+err_free_entity:
+	media_entity_cleanup(&sensor->sd.entity);
+err_free_ep:
+	return ret;
+}
+
+static void hsi16_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct hsi16_dev *sensor = to_hsi16_dev(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sensor->ctrl_handler);
+	pm_runtime_disable(sensor->dev);
+	mutex_destroy(&sensor->lock);
+}
+
+static const struct of_device_id hsi16_of_match[] = {
+	{ .compatible = "vendor,hsi16-sensor" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, hsi16_of_match);
+
+static struct i2c_driver hsi16_i2c_driver = {
+	.driver = {
+		.name = "hsi16",
+		.of_match_table = hsi16_of_match,
+		.pm = pm_ptr(&hsi16_pm_ops),
+	},
+	.probe = hsi16_probe,
+	.remove = hsi16_remove,
+};
+module_i2c_driver(hsi16_i2c_driver);
+
+MODULE_AUTHOR("Mika Kahola <mika.kahola@kolumbus.fi>");
+MODULE_DESCRIPTION("HSI16 16-band mosaic hyperspectral sensor driver");
+MODULE_LICENSE("GPL");
